# Flask Configuration
SECRET_KEY=dobrodelo-secret-key-change-in-production
FLASK_APP=run.py
FLASK_DEBUG=True

# Database Configuration
# По умолчанию используется SQLite (не требует настройки).
# Для переключения на PostgreSQL раскомментируйте строку ниже и укажите ваш пароль:
DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql+psycopg2://postgres:ВАШ_ПАРОЛЬ@localhost:5432/dobrodelo
